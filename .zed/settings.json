// Kubernetes YAML 补全配置：使用单一全量 schema(包含所有资源类型,避免多 schema 冲突)
// 单个 all.json 即可覆盖全部 K8s 资源类型验证与补全
// 来源：https://github.com/yannh/kubernetes-json-schema
{
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--query-driver=C:/Users/felix/AppData/Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/g++.exe",
          "--background-index"
        ]
      },
      "initialization_options": {
        "fallbackFlags": [
          "--target=x86_64-w64-mingw32",
          "-std=c++17"
        ]
      }
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "kubernetesCRDStore": { "enable": true },
          "validate": true,
          "hover": true,
          "completion": true,
          "schemas": {
            "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/v1.34.1-standalone-strict/all.json": "*.yaml"
          }
        }
      }
    }
  }
}
